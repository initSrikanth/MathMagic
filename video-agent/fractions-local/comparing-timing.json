        "d": 3,
        "label": "One third",
        "colour": "teal"
      },
      {
        "n": 1,
        "d": 6,
        "label": "One sixth",
        "colour": "gold"
      }
    ],
    "note": "For unit fractions, compare the size of one piece.",
    "line": null,
    "area": null,
    "context": null
  },
  {
    "index": 7,
    "start": 41.525124716553286,
    "end": 47.59678004535147,
