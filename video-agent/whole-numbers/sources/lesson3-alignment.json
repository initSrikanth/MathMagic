      "narration": "Which number is larger when most of the digits match? Compare from the greatest place value, not from the right. For whole numbers with no leading zeros, more digits means a larger number. If the lengths match, compare one column at a time.",
      "heading": "Start with the greatest place",
      "rows": [
        {
          "cue": "more digits",
          "text": "100,000 > 99,999"
        },
        {
          "cue": "one column",
          "text": "Compare from left to right \u2192"
        }
      ],
      "model": null,
      "start": 0.2,
      "speech_end": 13.76,
      "events": [
        {
          "cue": "more digits",
          "text": "100,000 > 99,999",
