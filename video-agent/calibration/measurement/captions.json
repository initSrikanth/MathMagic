[
  {
    "start": 0,
    "end": 3.1999998092651367,
    "text": "Could this ribbon really be nine centimetres long?"
  },
  {
    "start": 3.1999998092651367,
    "end": 4.239999771118164,
    "text": "Look closely!"
  },
  {
    "start": 4.239999771118164,
    "end": 6.395208333333334,
    "text": "It starts at two, not zero."
  },
  {
    "start": 6.395208333333334,
    "end": 11.887916666666667,
    "text": "Today, let's learn to measure the distance between the marks, rather than just reading the last number."
  },
  {
    "start": 11.887916666666667,
    "end": 14.887916666666667,
    "text": "Before we calculate, what length do you predict?"
  },
  {
    "start": 14.887916666666667,
    "end": 18.850125000000002,
    "text": "Follow the spaces with your finger, and keep your answer in mind."
  },
  {
    "start": 18.850125000000002,
    "end": 20.850125000000002,
    "text": "Now trace from two to nine."
  },
  {
    "start": 20.850125000000002,
    "end": 23.61012475204468,
    "text": "Each equal space is one centimetre."
  },
  {
    "start": 23.61012475204468,
    "end": 26.22804166666667,
    "text": "We count seven spaces altogether!"
  },
  {
    "start": 26.22804166666667,
    "end": 28.50804163805644,
    "text": "Nine minus two equals seven."
  },
  {
    "start": 28.50804163805644,
    "end": 31.38804151407878,
    "text": "So, the ribbon is seven centimetres long."
  },
  {
    "start": 31.38804151407878,
    "end": 33.066833333333335,
    "text": "Did your prediction match?"
  },
  {
    "start": 33.066833333333335,
    "end": 34.26683326180776,
    "text": "Great thinking!"
  },
  {
    "start": 34.26683326180776,
    "end": 36.74683316167196,
    "text": "Moving the ruler cannot stretch the ribbon."
  },
  {
    "start": 36.74683316167196,
    "end": 40.40270833333334,
    "text": "Check the start, count the intervals, then explain your answer."
  }
]