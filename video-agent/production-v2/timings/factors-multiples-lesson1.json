        "rows": 4,
        "cols": 6
      }
    },
    {
      "index": 4,
      "start": 54.006083333333336,
      "end": 64.299875,
      "lesson_progress": 0.4166666666666667,
      "text": "Start with twenty-four tiles. One row of twenty-four works. Two rows of twelve work too, as do three rows of eight and four rows of six.",
