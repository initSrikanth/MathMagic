    {
      "index": 3,
      "start": 32.24191666666667,
      "end": 54.006083333333336,
      "lesson_progress": 0.3333333333333333,
      "text": "Factors are whole numbers that multiply to make a product. A factor pair gives the number of rows and the number in each row of a rectangular array. Exact division tells us whether a proposed row size works. Picture twenty-four tiles in four equal rows of six. The row count and tiles in each row form a factor pair.",
      "chapter": "Build the idea",
      "equation": [],
      "board": [],
      "rows": [],
      "line": null,
      "area": null,
      "context": null,
      "note": "",
      "role": "explanation",
      "model": {
