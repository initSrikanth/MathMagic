      "lesson_progress": 0.18181818181818182,
      "text": "Our learning goal is to explain percentages as parts of a whole divided into 100 equal parts.",
      "chapter": "Today’s Learning Goal",
      "equation": [],
      "board": [
        "Explain percentages as parts of a whole divided into 100 equal parts."
      ],
      "rows": [],
