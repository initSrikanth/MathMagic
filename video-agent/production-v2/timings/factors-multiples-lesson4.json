    {
      "index": 3,
      "start": 33.09466666666667,
      "end": 56.052375,
      "lesson_progress": 0.3333333333333333,
      "text": "Choose the target number and start with one. Test exact division. If it works, record the candidate and its partner. Increase the candidate by one. Stop when the candidate is greater than its possible partner, because pairs would repeat in reverse. For a small start, twelve has the pairs one and twelve, two and six, three and four.",
      "chapter": "Build the idea",
      "equation": [],
      "board": [],
      "rows": [],
      "line": null,
      "area": null,
      "context": null,
      "note": "",
