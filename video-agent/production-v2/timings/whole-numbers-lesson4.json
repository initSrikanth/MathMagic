      "rows": [],
      "line": null,
      "area": null,
      "context": null,
      "note": "",
      "role": "explanation",
      "model": null
    },
    {
      "index": 4,
      "start": 72.344,
      "end": 90.29329166666666,
      "lesson_progress": 0.625,
      "text": "Think of a measuring scale marked in equal small steps. Thousandths let us describe positions more precisely than hundredths. This is about understanding place value, not just counting how many digits come after the point. Keep the whole and the size of each part clear.",
