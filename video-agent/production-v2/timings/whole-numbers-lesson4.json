    {
      "index": 3,
      "start": 54.918375,
      "end": 72.344,
      "lesson_progress": 0.5,
      "text": "A tenth is ten hundredths. A hundredth is ten thousandths. Now compare zero point five with zero point zero five. Five tenths is ten times five hundredths, so zero point five is greater. The same digit does not mean the same value.",
      "chapter": "Connect neighbouring places",
      "equation": [],
      "board": [
        "0.1 = 10 × 0.01",
        "0.01 = 10 × 0.001",
        "0.5 = 10 × 0.05",
        "0.5 > 0.05"
