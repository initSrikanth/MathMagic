      "area": null,
      "context": null,
      "note": "",
      "role": "explanation"
    },
    {
      "index": 7,
      "start": 76.817625,
      "end": 87.862875,
      "lesson_progress": 0.7272727272727273,
      "text": "The six represents six hundredths, or zero point zero six. Name the place before stating the value. It does not represent six tenths or six whole ones.",
      "chapter": "Example 2: explain",
      "equation": [],
      "board": [
