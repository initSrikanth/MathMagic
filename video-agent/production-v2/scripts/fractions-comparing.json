          "n": 3,
          "d": 4,
          "label": "Three quarters",
          "colour": "teal"
        },
        {
          "n": 2,
          "d": 4,
          "label": "Two quarters",
          "colour": "gold"
        }
      ],
      "note": "Compare the numerators when denominators match.",
      "line": null,
      "area": null,
      "context": null,
      "role": "explanation"
    },
    {
      "text": "Now compare one third and one sixth. These wholes are the same length, but the sixths are smaller pieces.",
